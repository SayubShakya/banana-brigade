# Copy to .env (run.sh does this for you). Never commit .env.
PORT=3100
# Long random string that signs the session cookie.
SESSION_SECRET=change-me
# Set to production behind HTTPS (makes the session cookie Secure).
NODE_ENV=development
# Optional: point at a broken address to demonstrate Banana API error handling.
# BANANA_API_URL=https://marcconrad.com/uob/banana/api.php
# BANANA_API_TIMEOUT_MS=5000
