# Copy to .env (run.sh does this for you). Never commit .env.
PORT=3100
# Long random string that signs the session cookie.
SESSION_SECRET=change-me
# Set to production behind HTTPS (makes the session cookie Secure).
NODE_ENV=development
# MongoDB: local by default. For MongoDB Atlas use mongodb+srv://user:pass@cluster.../banana_brigade
MONGODB_URI=mongodb://127.0.0.1:27017/banana_brigade
# Optional: point at a broken address to demonstrate Banana API error handling.
# BANANA_API_URL=https://marcconrad.com/uob/banana/api.php
# BANANA_API_TIMEOUT_MS=5000
# Address of the site, used in password reset links (needed in production).
# APP_URL=http://localhost:3100
# New passwords are checked against Have I Been Pwned (only 5 characters of the SHA-1 hash are sent).
# Set to off to skip the check (e.g. with no internet).
# PWNED_CHECK=off
