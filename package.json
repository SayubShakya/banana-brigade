{
  "name": "banana-brigade",
  "version": "1.3.2",
  "description": "Banana Brigade: a 2D jetpack shooter with a campaign, online multiplayer and a daily challenge, where Banana API puzzles deploy, revive and arm your soldier. Node.js, Express, MongoDB, Socket.io and React.",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "build": "vite build",
    "dev:client": "vite",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "package": "git archive --format=zip --prefix=banana-brigade/ -o ../banana-brigade-source.zip HEAD && echo \"Created ../banana-brigade-source.zip (tracked files only: no .env, node_modules or data)\"",
    "e2e": "playwright test",
    "openapi": "node scripts/openapi-yaml.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Sayub Shakya",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@vitejs/plugin-react": "^6.1.2",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^8.3.5"
  }
}
